    "@tanstack/router-devtools": "^1.167.0",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.7.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
